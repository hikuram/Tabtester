BASE_IMAGE=nvcr.io/nvidia/pytorch:26.05-py3
TABTESTER_PORT=8501

# Models to place in the persistent model cache: none, tabicl, tabfm, or all.
# This is used by `docker compose run --rm model-prefetch`, not by image build.
PREFETCH_FOUNDATION_MODELS=tabicl

# Set to 1 only after accepting the TabFM pretrained-weight license.
ACCEPT_TABFM_LICENSE=0

# Runtime is offline by default. Prefetch always enables network access for its own run.
HF_HUB_OFFLINE=1
TABFM_CHECKPOINT_PATH=

# Optional Japanese-specific compatibility.
# 0: UTF-8/UTF-16 CSV input and default Matplotlib fonts.
# 1: also allow CP932 CSV input and install/use Japanese-capable plot fonts.
ENABLE_JAPANESE_SUPPORT=0
